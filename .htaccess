# Включение механизма перезаписи
RewriteEngine On
RewriteBase /

# Указываем, что правило не срабатывает для index.html
RewriteRule ^index\.html$ - [L]

# Проверяем, что запрашиваемый файл не существует
RewriteCond %{REQUEST_FILENAME} !-f
# Проверяем, что запрашиваемая директория не существует
RewriteCond %{REQUEST_FILENAME} !-d

# Если условия выполнены, направляем все запросы на index.html
RewriteRule . /index.html [L]

# ======== CORS настройки ========

# Разрешить CORS заголовки для всех источников
Header set Access-Control-Allow-Origin "*"
# Разрешить GET и POST методы
Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
# Разрешить заголовки, прежде всего для работы с диапазонами (Range) (add Content-Type)
Header set Access-Control-Allow-Headers "Range, X-Playback-Session-Id, Content-Type"

# Обработка предзапроса (OPTIONS)
# Если запрос типа OPTIONS, завершаем его здесь, не продолжая обработку.
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>
# ======== Закончили CORS настройки ========

# ======== Настройки кеширования ========

# Включаем механизм Expires
<IfModule mod_expires.c>
    ExpiresActive On

    # Устанавливаем срок жизни по умолчанию на 1 месяц
    ExpiresDefault "access plus 1 month"

    # Кеширование изображений на 1 год
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"

    # Кеширование CSS и JavaScript на 1 месяц
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"

    # Кеширование шрифтов на 1 год
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>

# Установка заголовков Cache-Control для статических ресурсов
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|css|js|woff|woff2|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
# ======== Закончили настройки кеширования ========